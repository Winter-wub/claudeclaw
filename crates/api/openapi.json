          "to": {
            "type": "string",
            "format": "date",
            "description": "Last day, inclusive, in `tz`."
          },
          "tz": {
            "type": "string",
            "description": "The IANA time zone the caller chose for day boundaries."
          },
          "currency": {
            "type": "string",
            "description": "Always `USD`."
