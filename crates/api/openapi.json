          "cache_read_tokens",
          "cache_write_tokens",
          "cache_hit_pct",
          "cost_usd",
          "cost_trust"
        ],
        "properties": {
          "runs": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "tokens_in": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "tokens_out": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "cache_read_tokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "cache_write_tokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "cache_hit_pct": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
