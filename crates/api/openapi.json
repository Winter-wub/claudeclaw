{
  "openapi": "3.1.0",
  "info": {
    "title": "ClaudeClaw Management API",
    "description": "The Daemon's HTTP/JSON + SSE API, served on the local socket or pipe and, when enabled, on the pinned-TLS remote listener.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "1"
  },
  "paths": {},
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "description": "`{\"error\": {\"code\", \"message\", \"hint\", \"details\"}}`.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        }
      },
      "AttachmentUpload": {
        "type": "object",
        "description": "One file sent with a Turn (management-api §2.3; the CLI's `send --file`).",
        "required": [
          "name",
          "content_type",
          "data_base64"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "content_type": {
            "type": "string"
          },
          "data_base64": {
            "type": "string",
            "description": "The file's bytes, standard base64."
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "description": "Never echoes a Launcher's arguments, a secret or request content (#8, #23 D6)."
          },
          "hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "details": {
            "type": "object",
            "description": "Code-specific fields, e.g. `current` for `revision_mismatch`.",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "bad_request",
          "invalid_scope",
          "invalid_cursor",
          "unauthorized",
          "unknown_device",
          "device_revoked",
          "pairing_code_invalid",
          "missing_permission",
          "local_only",
          "not_found",
          "transcript_not_found",
          "revision_mismatch",
          "job_exists",
          "agent_exists",
          "session_in_use",
          "remote_disabled",
          "plan_changed",
          "use_job_frontmatter",
          "export_busy",
          "pairing_expired",
          "payload_too_large",
          "job_invalid",
          "launcher_not_runnable",
          "ts_only_key",
          "unknown_key",
          "invalid_value",
          "invalid_permission_set",
          "exe_check_failed",
          "invalid_host",
          "revision_required",
          "internal",
          "export_leak",
          "daemon_starting",
          "daemon_stopping",
          "deadline_exceeded",
          "insufficient_storage"
        ]
      },
      "Revision": {
        "type": "string",
        "description": "The first 16 hex digits of SHA-256 over the file's bytes. Send it back as `If-Match`.",
        "pattern": "^[0-9a-f]{16}$"
      },
      "Scope": {
        "type": "string",
        "description": "A Scope: `global`, `discord:<id>` (channel or thread), `job:<name>` (`<agent>/<stem>` for an agent's job) or `agent:<name>`.",
        "examples": [
          "global",
          "discord:1234",
          "job:researcher/paper-digest"
        ],
        "pattern": "^(global|discord:[0-9]+|job:[^/]+(/[^/]+)?|agent:[^/]+)$"
      },
      "SessionCompacted": {
        "type": "object",
        "description": "What a manual compact did: `TurnRecord.compact` (management-api §2.5 `sessions.compact`,\n#40 D7).",
        "required": [
          "scope",
          "launcher",
          "ok",
          "context_before",
          "context_after"
        ],
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "launcher": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "context_before": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "The session's context in tokens before the compact (`context.used_tokens`, #39 D4);\n`null` when it isn't known, e.g. an imported session before its first Rust Turn.",
            "minimum": 0
          },
          "context_after": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "The same after the compact; `null` when it failed.",
            "minimum": 0
          }
        }
      },
      "TokenPermission": {
        "type": "string",
        "enum": [
          "send",
          "jobs:run",
          "status:read",
          "logs:read",
          "runs:content"
        ]
      },
      "TurnAccepted": {
        "type": "object",
        "description": "`202` from `turns.create`, `jobs.run` and `sessions.compact` (management-api §2.3, #40 D7).",
        "required": [
          "turn_id",
          "scope",
          "queue_position"
        ],
        "properties": {
          "turn_id": {
            "type": "string"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "queue_position": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "TurnAgentState": {
        "type": "string",
        "enum": [
          "spawned",
          "done"
        ]
      },
      "TurnEvent": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "position",
              "kind"
            ],
            "properties": {
              "position": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "kind": {
                "type": "string",
                "enum": [
                  "queued"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "run_id",
              "attempt",
              "session",
              "session_id",
              "launcher",
              "kind"
            ],
            "properties": {
              "run_id": {
                "type": "string"
              },
              "attempt": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "session": {
                "$ref": "#/components/schemas/TurnSession"
              },
              "session_id": {
                "type": "string"
              },
              "launcher": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "started"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "A piece of the reply as it streams.",
            "required": [
              "delta",
              "kind"
            ],
            "properties": {
              "delta": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "text"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "name",
              "category",
              "summary",
              "kind"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "tool"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "name",
              "ok",
              "kind"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "ok": {
                "type": "boolean"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "tool_result"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "description",
              "state",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "state": {
                "$ref": "#/components/schemas/TurnAgentState"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "agent"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "reason_kind",
              "attempt",
              "at",
              "kind"
            ],
            "properties": {
              "reason_kind": {
                "type": "string"
              },
              "attempt": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "retry"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "reason_kind",
              "kind"
            ],
            "properties": {
              "reason_kind": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "refused"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "record",
              "kind"
            ],
            "properties": {
              "record": {
                "$ref": "#/components/schemas/TurnRecord"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "outcome"
                ]
              }
            }
          }
        ],
        "description": "One event on `turns.events`, tagged by `kind`. The stream replays from the Turn's start\nand ends after `outcome`."
      },
      "TurnOutcome": {
        "type": "string",
        "enum": [
          "ok",
          "failed",
          "refused",
          "interrupted"
        ]
      },
      "TurnPurpose": {
        "type": "string",
        "enum": [
          "prompt",
          "compact"
        ]
      },
      "TurnRecord": {
        "type": "object",
        "description": "A Turn as `turns.get` and `?wait=` return it (management-api §2.3, #40). It matches #22's\n`send --json`.",
        "required": [
          "turn_id",
          "scope",
          "origin",
          "principal",
          "purpose",
          "state",
          "outcome",
          "text",
          "compact",
          "session_id",
          "launcher",
          "run_ids",
          "created_at",
          "finished_at",
          "duration_ms"
        ],
        "properties": {
          "turn_id": {
            "type": "string"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "origin": {
            "type": "string",
            "description": "Where the Turn came from: `discord`, `scheduler`, `heartbeat`, `api`, `cli`, … (#23)."
          },
          "principal": {
            "type": [
              "string",
              "null"
            ],
            "description": "The API principal that created it (`local`, `device:<id>`, `token:<id>`); `null` when the\nTurn didn't come through the API."
          },
          "purpose": {
            "$ref": "#/components/schemas/TurnPurpose"
          },
          "state": {
            "$ref": "#/components/schemas/TurnState"
          },
          "outcome": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TurnOutcome",
                "description": "`null` until `state` is `done`."
              },
              {
                "type": "null"
              }
            ]
          },
          "text": {
            "type": [
              "string",
              "null"
            ],
            "description": "The reply text; `null` until done, or when there is none."
          },
          "compact": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SessionCompacted",
                "description": "Set when `purpose` is `compact`."
              },
              {
                "type": "null"
              }
            ]
          },
          "session_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "`null` until the first run has a session."
          },
          "launcher": {
            "type": [
              "string",
              "null"
            ],
            "description": "`direct` or a Launcher path; `null` until the Turn's first run resolves it."
          },
          "run_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Every run the Turn spawned, in order: the first attempt, a compact, a retry (#33)."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "`null` until done.",
            "minimum": 0
          }
        }
      },
      "TurnRequest": {
        "type": "object",
        "description": "`turns.create`'s body (management-api §2.3). Only `text` is required.",
        "required": [
          "text"
        ],
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope",
            "default": "global"
          },
          "text": {
            "type": "string"
          },
          "attachments": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/AttachmentUpload"
            },
            "description": "At most 5, 10 MB each. Written to `inbox/api/` and handed to Claude as files."
          },
          "notify": {
            "type": "boolean",
            "description": "Also send the reply to the owner through every adapter's `Notifier` (#22 `send --notify`).",
            "default": false
          }
        }
      },
      "TurnSession": {
        "type": "string",
        "enum": [
          "new",
          "resumed"
        ]
      },
      "TurnState": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "done"
        ]
      }
    }
  }
}
