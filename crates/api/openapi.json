{
  "openapi": "3.1.0",
  "info": {
    "title": "ClaudeClaw Management API",
    "description": "The Daemon's HTTP/JSON + SSE API, served on the local socket or pipe and, when enabled, on the pinned-TLS remote listener.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "1"
  },
  "paths": {},
  "components": {
    "schemas": {
      "AgenticMode": {
        "type": "object",
        "description": "One `agentic.modes[]` entry (TS `AgenticMode`).",
        "required": [
          "name",
          "model",
          "keywords"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "phrases": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AgenticSettings": {
        "type": "object",
        "description": "`agentic`: model routing by the message's wording (TS `AgenticConfig`).",
        "required": [
          "enabled",
          "defaultMode",
          "modes"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "defaultMode": {
            "type": "string"
          },
          "modes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AgenticMode"
            }
          }
        }
      },
      "ApiError": {
        "type": "object",
        "description": "`{\"error\": {\"code\", \"message\", \"hint\", \"details\"}}`.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        }
      },
      "AutoCompactLast": {
        "type": "object",
        "description": "One auto-compact run (#33).",
        "required": [
          "at",
          "outcome",
          "duration_ms"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "outcome": {
            "$ref": "#/components/schemas/CompactOutcome"
          },
          "duration_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "AutoCompactSettings": {
        "type": "object",
        "description": "`auto_compact` (#33).",
        "required": [
          "enabled",
          "timeout_secs"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "timeout_secs": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "AutoCompactState": {
        "type": "object",
        "description": "The session's Auto-compact budget (#33): one compact per stretch of failures.",
        "required": [
          "spent_at",
          "last"
        ],
        "properties": {
          "spent_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When this stretch's compact was spent; `null` while the budget is unspent."
          },
          "last": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AutoCompactLast",
                "description": "The session's last auto-compact; `null` when it never had one."
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ClaudeCodeSeen": {
        "type": "object",
        "description": "The Claude Code version seen through a Launcher (#42 D5).",
        "required": [
          "version",
          "seen_at",
          "outdated"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "seen_at": {
            "type": "string",
            "format": "date-time"
          },
          "outdated": {
            "type": "boolean",
            "description": "Below the minimum ClaudeClaw supports (#42 D4)."
          }
        }
      },
      "CompactOutcome": {
        "type": "string",
        "enum": [
          "ok",
          "failed",
          "timeout",
          "interrupted",
          "rate_limited"
        ]
      },
      "DiscordSettings": {
        "type": "object",
        "description": "`discord` (TS `DiscordConfig`). Snowflakes are strings.",
        "required": [
          "token",
          "allowedUserIds",
          "listenChannels",
          "listenGuilds",
          "allowedGuilds",
          "channelAllowedUserIds",
          "channelNames",
          "imageOutputRoots",
          "streaming"
        ],
        "properties": {
          "token": {
            "$ref": "#/components/schemas/SecretState"
          },
          "allowedUserIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "listenChannels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "listenGuilds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowedGuilds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "channelAllowedUserIds": {
            "type": "object",
            "description": "Channel snowflake → extra user snowflakes allowed in that channel.",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "channelNames": {
            "type": "object",
            "description": "Channel snowflake → friendly name.",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "imageOutputRoots": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Absolute path prefixes images may be uploaded from."
          },
          "streaming": {
            "type": "boolean"
          }
        }
      },
      "DiskSettings": {
        "type": "object",
        "description": "`disk`: the free-space floors (#44).",
        "required": [
          "warnFreeMiB",
          "minFreeMiB"
        ],
        "properties": {
          "warnFreeMiB": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "minFreeMiB": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "description": "Never echoes a Launcher's arguments, a secret or request content (#8, #23 D6)."
          },
          "hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "details": {
            "type": "object",
            "description": "Code-specific fields, e.g. `current` for `revision_mismatch`.",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "bad_request",
          "invalid_scope",
          "invalid_cursor",
          "unauthorized",
          "unknown_device",
          "device_revoked",
          "pairing_code_invalid",
          "missing_permission",
          "local_only",
          "not_found",
          "transcript_not_found",
          "revision_mismatch",
          "job_exists",
          "agent_exists",
          "session_in_use",
          "remote_disabled",
          "plan_changed",
          "use_job_frontmatter",
          "export_busy",
          "pairing_expired",
          "payload_too_large",
          "job_invalid",
          "launcher_not_runnable",
          "ts_only_key",
          "unknown_key",
          "invalid_value",
          "invalid_permission_set",
          "exe_check_failed",
          "invalid_host",
          "revision_required",
          "internal",
          "export_leak",
          "daemon_starting",
          "daemon_stopping",
          "deadline_exceeded",
          "insufficient_storage"
        ]
      },
      "ExcludeWindow": {
        "type": "object",
        "description": "A `heartbeat.excludeWindows[]` entry (TS `HeartbeatExcludeWindow`).",
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "days": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            },
            "description": "Weekdays, 0 = Sunday; every day when absent."
          },
          "start": {
            "type": "string",
            "description": "`HH:MM`."
          },
          "end": {
            "type": "string",
            "description": "`HH:MM`."
          }
        }
      },
      "FallbackSettings": {
        "type": "object",
        "description": "`fallback`: the model and token a rate-limited run retries with (TS `ModelConfig`).",
        "required": [
          "model",
          "api"
        ],
        "properties": {
          "model": {
            "type": "string"
          },
          "api": {
            "$ref": "#/components/schemas/SecretState"
          }
        }
      },
      "HeartbeatSettings": {
        "type": "object",
        "description": "`heartbeat` (TS `HeartbeatConfig`).",
        "required": [
          "enabled",
          "interval",
          "prompt",
          "excludeWindows"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "interval": {
            "type": "integer",
            "format": "int32",
            "description": "Minutes between heartbeats.",
            "minimum": 0
          },
          "prompt": {
            "type": "string"
          },
          "excludeWindows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExcludeWindow"
            }
          }
        }
      },
      "InboxSettings": {
        "type": "object",
        "description": "`inbox`: attachment retention (#44). `null` keeps forever / sets no cap.",
        "required": [
          "keepDays",
          "maxMiB"
        ],
        "properties": {
          "keepDays": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "maxMiB": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "InheritedFrom": {
        "type": "string",
        "description": "A Scope, or `default` when nothing in the chain sets one.",
        "examples": [
          "default",
          "discord:1234"
        ],
        "pattern": "^(default|global|discord:[0-9]+|job:[^/]+(/[^/]+)?|agent:[^/]+)$"
      },
      "LastTest": {
        "type": "object",
        "description": "The summary of a Launcher's last test (management-api §2.5, #42).",
        "required": [
          "ok",
          "tested_at",
          "failed_checks",
          "claude_code_version"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "tested_at": {
            "type": "string",
            "format": "date-time"
          },
          "failed_checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LauncherCheckId"
            }
          },
          "claude_code_version": {
            "type": [
              "string",
              "null"
            ],
            "description": "The Claude Code version the test saw; `null` when it saw none (#42 D5)."
          }
        }
      },
      "LauncherCheck": {
        "type": "object",
        "description": "One Test launcher check (management-api §2.5). Its `detail` never shows the Launcher's\narguments (#8).",
        "required": [
          "id",
          "ok",
          "advisory",
          "detail"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/LauncherCheckId"
          },
          "ok": {
            "type": "boolean"
          },
          "advisory": {
            "type": "boolean",
            "description": "An advisory check never makes the result's `ok` false (#39 D6)."
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "LauncherCheckId": {
        "type": "string",
        "enum": [
          "runnable",
          "print_stream_json",
          "clean_stdout",
          "system_prompt",
          "result_event",
          "prompt_stdin",
          "claude_code_version",
          "transcript",
          "stragglers"
        ]
      },
      "LauncherInfo": {
        "type": "object",
        "description": "One Launcher card (management-api §2.5).",
        "required": [
          "launcher",
          "builtin",
          "runnable",
          "last_test",
          "used_by",
          "claude_code"
        ],
        "properties": {
          "launcher": {
            "type": "string"
          },
          "builtin": {
            "type": "boolean",
            "description": "`true` for `direct`."
          },
          "runnable": {
            "$ref": "#/components/schemas/Runnable"
          },
          "last_test": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/LastTest",
                "description": "The last Test launcher result, kept in `daemon/state/launcher-tests.json`."
              },
              {
                "type": "null"
              }
            ]
          },
          "used_by": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LauncherUse"
            }
          },
          "claude_code": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ClaudeCodeSeen",
                "description": "The Claude Code version seen through this Launcher, from its newest run or test (#42)."
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "LauncherOverview": {
        "type": "object",
        "description": "`launchers.list` → the Launchers screen (management-api §2.5, #22 `launcher list`).",
        "required": [
          "default",
          "picker",
          "launchers",
          "scopes"
        ],
        "properties": {
          "default": {
            "type": "string",
            "description": "The default Launcher: `\"direct\"` or an absolute path."
          },
          "picker": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "`direct` plus every path in use (#8)."
          },
          "launchers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LauncherInfo"
            }
          },
          "scopes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScopeLauncher"
            }
          }
        }
      },
      "LauncherSet": {
        "type": "object",
        "description": "`launchers.set` body (management-api §2.5).",
        "required": [
          "launcher"
        ],
        "properties": {
          "launcher": {
            "type": "string",
            "description": "`\"direct\"` or an absolute path."
          }
        }
      },
      "LauncherSetResult": {
        "type": "object",
        "description": "`launchers.set` → the Scope's new Launcher and what happened to its session (management-api\n§2.5).",
        "required": [
          "scope",
          "launcher",
          "effective",
          "session"
        ],
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "launcher": {
            "type": "string"
          },
          "effective": {
            "type": "string"
          },
          "session": {
            "$ref": "#/components/schemas/SessionStart",
            "description": "`resumed` when the Scope already had a session with this Launcher (#8)."
          }
        }
      },
      "LauncherSource": {
        "type": "string",
        "enum": [
          "settings",
          "job_frontmatter",
          "default"
        ]
      },
      "LauncherTestRequest": {
        "type": "object",
        "description": "`launchers.test` body (management-api §2.5, #40). A request for a Launcher already under test\njoins that test.",
        "properties": {
          "launcher": {
            "type": [
              "string",
              "null"
            ],
            "description": "The Launcher to test; the effective Launcher of `scope` when absent."
          },
          "scope": {
            "$ref": "#/components/schemas/Scope",
            "default": "global"
          },
          "timeout_s": {
            "type": "integer",
            "format": "int32",
            "description": "Seconds the test run may take, 10–600 (`422 invalid_value` otherwise).",
            "default": 120,
            "maximum": 600,
            "minimum": 10
          }
        }
      },
      "LauncherTestResult": {
        "type": "object",
        "description": "`launchers.test` → every check's result (management-api §2.5, #22 `launcher test`).",
        "required": [
          "launcher",
          "scope",
          "ok",
          "checks",
          "claude_code",
          "duration_ms",
          "tested_at"
        ],
        "properties": {
          "launcher": {
            "type": "string"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "ok": {
            "type": "boolean",
            "description": "`false` if any check that isn't `advisory` failed."
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LauncherCheck"
            }
          },
          "claude_code": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ClaudeCodeSeen",
                "description": "The Claude Code version the test run reported; `null` when it reported none (#42)."
              },
              {
                "type": "null"
              }
            ]
          },
          "duration_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "tested_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LauncherUnset": {
        "type": "object",
        "description": "`launchers.unset` → the Launcher the Scope now inherits (management-api §2.5).",
        "required": [
          "scope",
          "effective",
          "inherited_from"
        ],
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "effective": {
            "type": "string"
          },
          "inherited_from": {
            "$ref": "#/components/schemas/InheritedFrom"
          }
        }
      },
      "LauncherUse": {
        "type": "object",
        "description": "A Scope that uses a Launcher (management-api §2.5).",
        "required": [
          "scope",
          "label",
          "via"
        ],
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "label": {
            "type": "string"
          },
          "via": {
            "$ref": "#/components/schemas/LauncherVia"
          }
        }
      },
      "LauncherVia": {
        "type": "string",
        "enum": [
          "settings",
          "job_frontmatter"
        ]
      },
      "LoggingSettings": {
        "type": "object",
        "description": "`logging` (#23 D1, #44).",
        "required": [
          "level",
          "daemonKeepFiles",
          "daemonMaxDailyMiB",
          "daemonMaxTotalMiB",
          "runLogKeepDays",
          "auditKeepMonths"
        ],
        "properties": {
          "level": {
            "type": "string",
            "description": "A tracing `EnvFilter` directive, e.g. `info,claudeclaw_discord=debug`."
          },
          "daemonKeepFiles": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "daemonMaxDailyMiB": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "daemonMaxTotalMiB": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "runLogKeepDays": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "`null` keeps Run logs forever.",
            "minimum": 0
          },
          "auditKeepMonths": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "`null` keeps the audit log forever.",
            "minimum": 0
          }
        }
      },
      "NotRunnable": {
        "type": "string",
        "enum": [
          "missing",
          "not_file",
          "not_executable"
        ]
      },
      "RemoteSettings": {
        "type": "object",
        "description": "`remote`: the pinned-TLS remote listener (architecture §7). Changed only locally.",
        "required": [
          "enabled",
          "listen",
          "port"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "listen": {
            "type": "string",
            "description": "The address it binds."
          },
          "port": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "Restarted": {
        "type": "string",
        "enum": [
          "discord",
          "remote_listener"
        ]
      },
      "Revision": {
        "type": "string",
        "description": "The first 16 hex digits of SHA-256 over the file's bytes. Send it back as `If-Match`.",
        "pattern": "^[0-9a-f]{16}$"
      },
      "RunLocaleSetting": {
        "type": "string",
        "enum": [
          "auto",
          "inherit"
        ]
      },
      "RunPathSettings": {
        "type": "object",
        "description": "`run_path`: where runs get their PATH (#26).",
        "required": [
          "source",
          "prepend"
        ],
        "properties": {
          "source": {
            "$ref": "#/components/schemas/RunPathSource"
          },
          "prepend": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Absolute dirs put first on the Run PATH."
          }
        }
      },
      "RunPathSource": {
        "type": "string",
        "enum": [
          "auto",
          "login_shell",
          "registry",
          "inherit"
        ]
      },
      "Runnable": {
        "type": "object",
        "description": "Whether a Launcher can be run now (management-api §2.5, #8).",
        "required": [
          "ok",
          "reason"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "reason": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/NotRunnable",
                "description": "Why not; `null` when `ok`."
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Scope": {
        "type": "string",
        "description": "A Scope: `global`, `discord:<id>` (channel or thread), `job:<name>` (`<agent>/<stem>` for an agent's job) or `agent:<name>`.",
        "examples": [
          "global",
          "discord:1234",
          "job:researcher/paper-digest"
        ],
        "pattern": "^(global|discord:[0-9]+|job:[^/]+(/[^/]+)?|agent:[^/]+)$"
      },
      "ScopeInfo": {
        "type": "object",
        "description": "One Scope for the Chat picker and the \"Who uses which launcher\" table (management-api §2.5).\nListed: `global`, every Discord channel or thread with config, a session or an override,\nevery job and every agent.",
        "required": [
          "scope",
          "kind",
          "label",
          "parent",
          "launcher",
          "session",
          "queue"
        ],
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "kind": {
            "$ref": "#/components/schemas/ScopeKind"
          },
          "label": {
            "type": "string",
            "description": "A display name. The app shows it and copies `scope` (#16)."
          },
          "parent": {
            "oneOf": [
              {
