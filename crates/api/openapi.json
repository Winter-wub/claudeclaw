            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "cache_read_tokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "cache_write_tokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
