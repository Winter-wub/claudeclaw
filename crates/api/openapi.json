          "outcome",
          "pipe_held",
          "settle_ms"
        ],
        "properties": {
          "stragglers": {
            "type": "integer",
            "format": "int32",
            "description": "Group members alive at leader exit; best-effort on Windows.",
            "minimum": 0
          },
          "outcome": {
            "$ref": "#/components/schemas/SettleOutcome"
          },
          "pipe_held": {
            "type": "boolean",
            "description": "Something outside the group still held the output pipe."
          },
          "settle_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "RunState": {
        "type": "string",
        "enum": [
          "running"
        ]
      },
      "Scope": {
        "type": "string",
        "description": "A Scope: `global`, `discord:<id>` (channel or thread), `job:<name>` (`<agent>/<stem>` for an agent's job) or `agent:<name>`.",
        "examples": [
          "global",
          "discord:1234",
          "job:researcher/paper-digest"
        ],
        "pattern": "^(global|discord:[0-9]+|job:[^/]+(/[^/]+)?|agent:[^/]+)$"
      },
      "SettleOutcome": {
        "type": "string",
