{
  "openapi": "3.1.0",
  "info": {
    "title": "ClaudeClaw Management API",
    "description": "The Daemon's HTTP/JSON + SSE API, served on the local socket or pipe and, when enabled, on the pinned-TLS remote listener.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "1"
  },
  "paths": {},
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "description": "`{\"error\": {\"code\", \"message\", \"hint\", \"details\"}}`.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        }
      },
      "AuditEntry": {
        "type": "object",
        "description": "One audit-log line: who changed what, when; never a secret, a prompt or a value (#13, #44).",
        "required": [
          "id",
          "at",
          "principal",
          "action",
          "target",
          "outcome"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "principal": {
            "type": "string",
            "description": "`local`, `local-offline`, `device:<id>`, `token:<id>`, `system:import` or\n`system:housekeeping`."
          },
          "action": {
            "type": "string",
            "description": "The route's Op, e.g. `jobs.update`."
          },
          "target": {
            "type": [
              "string",
              "null"
            ],
            "description": "An identifier (job name, Scope key, Device ID, a Housekeeping kind); `null` when the\naction has none."
          },
          "outcome": {
            "$ref": "#/components/schemas/AuditOutcome"
          },
          "code": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ErrorCode",
                "description": "Why it failed, when `outcome` is `error`."
              },
              {
                "type": "null"
              }
            ]
          },
          "count": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "How many things one aggregate entry covers, e.g. files one Housekeeping kind deleted.",
            "minimum": 0
          }
        }
      },
      "AuditOutcome": {
        "type": "string",
        "enum": [
          "ok",
          "error"
        ]
      },
      "AuditPage": {
        "type": "object",
        "description": "`audit.list`: one page, newest first (management-api §2.9).",
        "required": [
          "entries",
          "next"
        ],
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEntry"
            }
          },
          "next": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CostBasis": {
        "type": "string",
        "enum": [
          "list",
          "managed",
          "unknown"
        ]
      },
      "CostStatus": {
        "type": "string",
        "enum": [
          "priced",
          "no_baseline",
          "no_usage",
          "refused"
        ]
      },
      "CostTrust": {
        "type": "string",
        "enum": [
          "api_list",
          "managed",
          "estimate"
        ]
      },
      "DiskHousekeeping": {
        "type": "object",
        "description": "The last and next Housekeeping pass (#44 D7).",
        "required": [
          "last_at",
          "next_at",
          "deleted",
          "freed_bytes"
        ],
        "properties": {
          "last_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "`null` until the first pass."
          },
          "next_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "deleted": {
            "type": "object",
            "description": "Files the last pass deleted, by kind (`inbox`, `run_logs`, `run_index`, …).",
            "additionalProperties": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "freed_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "description": "Never echoes a Launcher's arguments, a secret or request content (#8, #23 D6)."
          },
          "hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "details": {
            "type": "object",
            "description": "Code-specific fields, e.g. `current` for `revision_mismatch`.",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "bad_request",
          "invalid_scope",
          "invalid_cursor",
          "unauthorized",
          "unknown_device",
          "device_revoked",
          "pairing_code_invalid",
          "missing_permission",
          "local_only",
          "not_found",
          "transcript_not_found",
          "revision_mismatch",
          "job_exists",
          "agent_exists",
          "session_in_use",
          "remote_disabled",
          "plan_changed",
          "use_job_frontmatter",
          "export_busy",
          "pairing_expired",
          "payload_too_large",
          "job_invalid",
          "launcher_not_runnable",
          "ts_only_key",
          "unknown_key",
          "invalid_value",
          "invalid_permission_set",
          "exe_check_failed",
          "invalid_host",
          "revision_required",
          "internal",
          "export_leak",
          "daemon_starting",
          "daemon_stopping",
          "deadline_exceeded",
          "insufficient_storage"
        ]
      },
      "ExportManifest": {
        "type": "object",
        "description": "What an export holds, without its text; `claudeclaw logs export --json` prints it (#28 D6).",
        "required": [
          "format",
          "created_at",
          "versions",
          "window",
          "lines",
          "runs",
          "pseudonyms",
          "trimmed",
          "map_written"
        ],
        "properties": {
          "format": {
            "type": "string",
            "description": "`claudeclaw-export/1`."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "versions": {
            "$ref": "#/components/schemas/ExportVersions"
          },
          "window": {
            "$ref": "#/components/schemas/ExportWindow"
          },
          "lines": {
            "type": "integer",
            "format": "int32",
            "description": "Daemon-log lines included, after trimming.",
            "minimum": 0
          },
          "runs": {
            "type": "integer",
            "format": "int32",
            "description": "Run index records included.",
            "minimum": 0
          },
          "pseudonyms": {
            "type": "object",
            "description": "Pseudonyms assigned, by kind (`discord`, `job`, …; see [`PseudonymKind`]).",
            "additionalProperties": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "trimmed": {
            "$ref": "#/components/schemas/ExportTrimmed"
          },
          "map_written": {
            "type": "boolean",
            "description": "The pseudonym key was written (`--map`, or `map=true`)."
          }
        }
      },
      "ExportSection": {
        "type": "string",
        "enum": [
          "header",
          "summary",
          "status",
          "settings",
          "jobs",
          "crash",
          "runs",
          "daemon_log"
        ]
      },
      "ExportTrimmed": {
        "type": "object",
        "description": "Daemon-log lines dropped to fit `max_bytes`, in trimming order; never silent (#28 D6).",
        "required": [
          "trace",
          "debug",
          "info",
          "warn_plus",
          "oldest_included"
        ],
        "properties": {
          "trace": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "debug": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "info": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "warn_plus": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "oldest_included": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "The oldest line still included; `null` when no line is."
          }
        }
      },
      "ExportVersions": {
        "type": "object",
        "description": "The versions in an export's Summary (#28 D1.2).",
        "required": [
          "claudeclaw",
          "commit",
          "target",
          "daemon",
          "app"
        ],
        "properties": {
          "claudeclaw": {
            "type": "string",
            "description": "The `claudeclaw` that made the export, as in `claudeclaw version`."
          },
          "commit": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "daemon": {
            "type": [
              "string",
              "null"
            ],
            "description": "The running Daemon's version; `null` when none answered."
          },
          "app": {
            "type": [
              "string",
              "null"
            ],
            "description": "The Desktop app's version, when the app made the export."
          }
        }
      },
      "ExportWindow": {
        "type": "object",
        "description": "The time window the Daemon log and runs sections cover (#28 D1).",
        "required": [
          "since",
          "until"
        ],
        "properties": {
          "since": {
            "type": "string",
            "format": "date-time"
          },
          "until": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LogCounts": {
        "type": "object",
        "description": "ERROR and WARN lines since the Worker started (#23 D5).",
        "required": [
          "error",
          "warn"
        ],
        "properties": {
          "error": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "warn": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "LogDisk": {
        "type": "object",
        "description": "What the Daemon keeps on disk (#23 D5, #44 D7).",
        "required": [
          "daemon_bytes",
          "run_log_files",
          "run_log_bytes",
          "audit_bytes",
          "inbox_files",
          "inbox_bytes",
          "inbox_foreign",
          "run_index_bytes",
          "outbox_bytes",
          "archive_bytes",
          "import_backup_bytes",
          "free_bytes",
          "housekeeping"
        ],
        "properties": {
          "daemon_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "run_log_files": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "run_log_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "audit_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "inbox_files": {
            "type": "integer",
            "format": "int32",
            "description": "Daemon-pattern files under `inbox/*`.",
            "minimum": 0
          },
          "inbox_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "inbox_foreign": {
            "type": "integer",
            "format": "int32",
            "description": "Files under `inbox/*` the Daemon didn't write, and so never deletes.",
            "minimum": 0
          },
          "run_index_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "outbox_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "archive_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "import_backup_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "free_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Free space on the project dir's volume; `null` when it couldn't be read.",
            "minimum": 0
          },
          "housekeeping": {
            "$ref": "#/components/schemas/DiskHousekeeping"
          }
        }
      },
      "LogEntry": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/LogLine"
          },
          {
            "$ref": "#/components/schemas/RawLogLine"
          }
        ],
        "description": "One Daemon-log line from `logs.tail`, `logs.stream` or `claudeclaw logs --offline`\n(#23 D5). A line that doesn't parse (a torn last line, foreign text) comes back as `Raw` and\nis never skipped."
      },
      "LogExport": {
        "type": "object",
        "description": "`logs.export`: one reviewable Markdown file, already scrubbed (management-api §2.9, #28 D7).",
        "required": [
          "manifest",
          "text"
        ],
        "properties": {
          "manifest": {
            "$ref": "#/components/schemas/ExportManifest"
          },
          "text": {
            "type": "string",
            "description": "The Markdown file."
          },
          "map": {
            "type": [
              "object",
              "null"
            ],
            "description": "The reverse map `{pseudonym: real value}`, only when the caller asked with `map=true`.",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "LogLevel": {
        "type": "string",
        "enum": [
          "ERROR",
          "WARN",
          "INFO",
          "DEBUG",
          "TRACE"
        ]
      },
      "LogLine": {
        "type": "object",
        "description": "A parsed Daemon-log line (#23 D2, D5). Content-free by #23 D6.",
        "required": [
          "seq",
          "timestamp",
          "level",
          "target",
          "message",
          "span",
          "fields"
        ],
        "properties": {
          "cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Opaque; pass it as `before`. Absent on streamed lines and in the Bug-report export."
          },
          "seq": {
            "type": "integer",
            "format": "int64",
            "description": "Per-process, restarting at 1; a gap means lost lines.",
            "minimum": 0
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "level": {
            "$ref": "#/components/schemas/LogLevel"
          },
          "target": {
            "type": "string"
          },
          "event": {
            "type": [
              "string",
              "null"
            ],
            "description": "The stable dotted event name; required at INFO and above from workspace crates."
          },
          "message": {
            "type": "string"
          },
          "span": {
            "type": "object",
            "description": "The current span's correlation fields (`run_id`, `scope`, `launcher`, …).",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          },
          "fields": {
            "type": "object",
            "description": "The event's own fields.",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "LogPage": {
        "type": "object",
        "description": "`logs.tail`: one page, newest first (management-api §2.9, #23 D5).",
        "required": [
          "lines",
          "next",
          "scan_truncated"
        ],
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LogEntry"
            }
          },
          "next": {
            "type": [
              "string",
              "null"
            ],
            "description": "The `before` cursor for the next page, or `null` at the end."
          },
          "scan_truncated": {
            "type": "boolean",
            "description": "The 50 MB scan bound stopped this page before `limit` lines; `next` continues it."
          }
        }
      },
      "LogSummary": {
        "type": "object",
        "description": "`logs.summary`: badges for the Logs and Status screens (management-api §2.9; #23 D5, #44).",
        "required": [
          "level",
          "since_boot",
          "dropped_lines",
          "capped_today",
          "disk"
        ],
        "properties": {
          "level": {
            "type": "string",
            "description": "The `EnvFilter` directive in effect, e.g. `info,claudeclaw_discord=debug`."
          },
          "since_boot": {
            "$ref": "#/components/schemas/LogCounts"
          },
          "dropped_lines": {
            "type": "integer",
            "format": "int32",
            "description": "Lines the Worker's sink dropped since boot (`log.dropped`).",
            "minimum": 0
          },
          "capped_today": {
            "type": "boolean",
            "description": "The daily cap was hit today (`log.capped`)."
          },
          "disk": {
            "$ref": "#/components/schemas/LogDisk"
          }
        }
      },
      "RawLogLine": {
        "type": "object",
        "description": "A Daemon-log line that didn't parse (#23 D5).",
        "required": [
          "raw"
        ],
        "properties": {
          "cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "raw": {
            "type": "string"
          }
        }
      },
      "Revision": {
        "type": "string",
        "description": "The first 16 hex digits of SHA-256 over the file's bytes. Send it back as `If-Match`.",
        "pattern": "^[0-9a-f]{16}$"
      },
      "RunIndexPhase": {
        "type": "string",
        "enum": [
          "ready",
          "backfilling",
          "failed"
        ]
      },
      "RunIndexState": {
        "type": "object",
        "description": "The Run index Back-fill's progress, so partial answers are labelled (#44 D2). Also served in\n`DaemonStatus.run_index`, `UsageReport.coverage.index` and `JobsAudit.index`.",
        "required": [
          "state",
          "done",
          "total",
          "since"
        ],
        "properties": {
          "state": {
            "$ref": "#/components/schemas/RunIndexPhase"
          },
          "done": {
            "type": "integer",
            "format": "int32",
            "description": "TS Run logs indexed so far by the current Back-fill.",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "format": "int32",
            "description": "TS Run logs the current Back-fill found missing.",
            "minimum": 0
          },
          "since": {
            "type": "string",
            "format": "date-time",
            "description": "When the index entered `state`."
          }
        }
      },
      "RunModelUsage": {
        "type": "object",
        "description": "One model's share of a run, per run by difference (#39 D8).",
        "required": [
          "model",
          "tokens_in",
          "tokens_out",
          "cache_read_tokens",
          "cache_write_tokens",
          "cost_usd",
          "cost_basis"
        ],
        "properties": {
          "model": {
            "type": "string"
          },
          "tokens_in": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "tokens_out": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "cache_read_tokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "cache_write_tokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "cost_usd": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "cost_basis": {
            "$ref": "#/components/schemas/CostBasis"
          }
        }
      },
      "RunOrigin": {
        "type": "string",
        "enum": [
          "discord",
          "scheduler",
          "heartbeat",
          "api",
          "cli",
          "bootstrap",
          "utility",
          "test",
          "ts"
        ]
      },
      "RunOutcome": {
        "type": "string",
        "enum": [
          "ok",
          "failed",
          "timeout",
          "interrupted",
          "rate_limited",
          "unknown"
        ]
      },
      "RunPage": {
        "type": "object",
        "description": "`runs.list`: running runs first, then the index newest first (management-api §2.9).",
        "required": [
          "runs",
          "next",
          "index"
        ],
        "properties": {
          "runs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RunRecord"
            }
          },
          "next": {
            "type": [
              "string",
              "null"
            ],
            "description": "The `before` cursor for the next page, or `null` at the end."
          },
          "index": {
            "$ref": "#/components/schemas/RunIndexState"
          }
        }
      },
      "RunPurpose": {
        "type": "string",
        "enum": [
          "turn",
          "compact",
          "compact_retry"
        ]
      },
      "RunRecord": {
        "type": "object",
        "description": "One spawned run: a line of `daemon/runs/<YYYY-MM>.jsonl`, and what `runs.get` returns\n(management-api §2.9, #23 D4). Refused runs get one too; every run in a Turn gets its own,\nsharing `turn_id` (#33). Back-filled TS records (`origin: ts`) leave every Rust-only measure\n`null` (#44 D2).",
        "required": [
          "run_id",
          "turn_id",
          "name",
          "scope",
          "origin",
          "launcher",
          "job",
          "agent",
          "session_id",
          "session",
          "model",
          "started_at",
          "ended_at",
          "duration_ms",
          "outcome",
          "exit_code",
          "is_error",
          "api_error_status",
          "attempt",
          "tokens_in",
          "tokens_out",
          "cache_read_tokens",
          "cache_write_tokens",
          "cost_usd",
          "cost_status",
          "cost_basis",
          "provider",
          "api_key_source",
          "models",
          "run_log",
          "launcher_resolved",
          "purpose",
          "settle",
          "awake_ms",
          "suspended_ms",
          "wake_grace",
          "claude_code_version",
          "lingered"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "turn_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "`null` for back-filled TS records."
          },
          "name": {
            "type": "string",
            "description": "The Run log name (`<name>-<iso>.log`)."
          },
          "scope": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Scope",
                "description": "`null` for back-filled TS records, whose header names no Scope."
              },
              {
                "type": "null"
              }
            ]
          },
          "origin": {
            "$ref": "#/components/schemas/RunOrigin"
          },
          "launcher": {
            "type": [
              "string",
              "null"
            ],
            "description": "`direct` or the Launcher's file name; `null` for back-filled TS records."
          },
          "job": {
            "type": [
              "string",
